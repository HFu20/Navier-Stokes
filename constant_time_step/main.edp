//fTS  << "k\t t\t Ek\t Work\t Eref\t L2Eu\t Emod\t Diss\t Eres\t Mass\t massErr\t rhoMin\t xiIters\t xi\t K\t absKminus1\n";
//fStep<< "lev\t k\t t\t Nx\t Nt\t xiIters\t rhoMin\t rhoMax\t massResidual\t Mn\t Mnm1\t Kn\t Knm1\t Xi\t Mass\n"; 

// previous level accumulators for rates
real prevDt = 0.0;
real prevL2 = 0.0, prevH1 = 0.0, prevDivL2 = 0.0, prevDivHm1 = 0.0;
real prevP = 0.0, prevRho = 0.0;
real prevMInf = 0.0/*, prevM2 = 0.0*/;
real prevKInf = 0.0, prevK2 = 0.0;
//real prevQInf = 0.0, prevQ2 = 0.0;
//real prevPH1 = 0.0, prevRhoH1 = 0.0;
int  prevNT = 0, prevNX = 0;

// ========================
// debug
// ========================

real prevL2uFE = 0.0, prevH1uFE = 0.0;
real prevL2pFE = 0.0/*, prevH1pFE = 0.0*/;
real prevL2rhoFE = 0.0/*, prevH1rhoFE = 0.0*/;


// ---- projection scalars (once per level) ----
int  qOrd = 10;   // quadrature for energy and diagnostics
real xi   = 0.0;  // Lagrange multiplier
int  xiIters = 0; // iteration count

border C(s=0, 2*pi){ x = cos(s); y = sin(s); label = 1; }

int  NxInit = NxFixed;

mesh Th = buildmesh( C(NxInit) );

// FE spaces
 fespace Vh(Th,P3);
 fespace Qh(Th,P2);
 fespace S2h(Th,P3);
 fespace P0h(Th,P0);


  // Bezier limiter for continuous P2 density
  include "BezierP3Limiter.idp"

matrix Aalpha;

  varf vAlphaL(a,b) =
    int2d(Th, qforder=6)(
        a*b
      + square(hTriangle)*(dx(a)*dx(b) + dy(a)*dy(b))
    );
macro BuildAlphaMatrix(S2h) {
    Aalpha = vAlphaL(S2h, S2h);
    set(Aalpha, solver=UMFPACK);
} //



 
int[int] NtList(L);
NtList[0] = Nt0;
for (int iNt=1; iNt<L; ++iNt){
    NtList[iNt] = 2 * NtList[iNt-1];
}

 

// ---------- refinement loop ----------
real totalCpuStart = clock();
for (int lev=0; lev<L; ++lev){

  real levCpuStart = clock();

  // Fixed spatial mesh; only the time grid is refined.
 int Nt = NtList[lev];
 real dt = (Tend - T0)/Nt;
  int Nx = NxFixed;
  real h = 2.0*pi/NxFixed;

 

 Th = buildmesh( C(Nx) );

  // After rebuilding Th, all Bezier data must be rebuilt.
nBezierDof = S2h.ndof;
Wb.resize(nBezierDof);

BuildBezierDofKP3(Th, S2h, BezierDofKP3);
BuildBezierWeightsP3(BezierDofKP3, Wb);
   
  BuildAlphaMatrix(S2h);

S2h hRV, hTest;

P0h areaK = area;
int polyDegRV = 3;

solve SmoothMeshSize(hRV, hTest, solver=UMFPACK) =
      int2d(Th, qforder=10)(
          hRV*hTest
        + areaK*(dx(hRV)*dx(hTest) + dy(hRV)*dy(hTest))
      )
    - int2d(Th, qforder=10)(
          sqrt(areaK)/polyDegRV*hTest
      );

  //fespace P0mac(Th, P1dc);
  //P0mac phiProj, qProj;

  // fields
  Vh uhat1,uhat2, uTF1,uTF2,u1n,u2n, u1nm1,u2nm1, uu1,uu2, u1star, u2star,w1,w2,what1,what2;
  Vh u1nm3,u2nm3; Vh u1nm2, u2nm2;
  Qh p, pTF,pn, pnm1, pStar, pp;
  Qh phiDivHm1, testDivHm1;
  S2h sig, sigN, sigNm1, sighat, sighatN, sighatNm1,
     rho, rhoN, rhoNm1, rhotilde, rhotildehat, rhotildeN, rhotildeNm1, muF, divUnF, qs;  //
  S2h rhoNm2,rhoNm3;
  P0h hK = hTriangle, tauK, uMagK; //the coefficient of SUPG
  S2h q;
  S2h divuRT,divuTF,divunonTF;
  S2h divutilde,divuTrue;
  Vh u1True,u2True;
  S2h Kappa , KappaU,AlphaFinal;
  S2h RatioRho,RatioMom,RatioDiv;
  S2h kUFloorMask;
// P2 high-mode sensor variables
Qh rhoLowSensor;
S2h rhoHighSensor, highSensor, kappaHigh;
//S2h alphaEff, kappaDamp;
//S2h kappaFloor;
S2h KappaCap, KappaFloor, kappaDamp;
S2h KappaRaw;
S2h AlphaRaw;

P0h uEffK, KappaURaw;
P0h uEffRhoK;

S2h f1RV, f2RV;

  
  



  
  P0h nudc,cflField;
  P0h gr;
  P0h rr;
  P0h cap;
  P0h gr2;
  P0h rr2;
  P0h cap2;
  P0h gammaGD;

  // accumulators for M errors over time (Linf and L2)
  real MerrSup = 0.0;
//  real MerrL2  = 0.0;
  

  // initial data at t0
  real t = T0;
  S2h rho0h = rhoExact(x,y,t);
  real rho0min = 1.8;
  real rho0max = 2.2;
   real rhoPhysMin = 0.0;
  real rhoPhysMax = 0.0;

  // Strict Bernstein bound for initial P2 density
  BezierClipP3(rho0h, rho0min, rho0max);

  u1n = u1Exact(x,y,t); u2n = u2Exact(x,y,t);
  u1nm1 = u1n; u2nm1 = u2n; u1nm2 = u1n; u2nm2 = u2n;u1nm3 = u1n; u2nm3 = u2n;
  rho = rho0h;
  rhoN = rho; rhoNm1 = rho; rhoNm2 = rho; rhoNm3 = rho;
  rhotilde = rho0h;
  rhotildeN = rhotilde; rhotildeNm1 = rhotilde; 
  pn = pExact(x,y,t); pnm1 = pn;

  sigN = sqrt( rho );
  sigNm1 = sigN;
  sig = sqrt( rho );

  real Mnm1 = 1.0;
  //Mn = 1.0; M=1.0;
    Mn = 1.0; M=1.0;
    Kn = 1.0; K=1.0;
    Qn = 1.0; Q=1.0;
    MTF=1.0;
    KTF=1.0;
    QTF=1.0;
 
  real Knm1 = 1.0;   real Qnm1 = 1.0;
  //Kn = 1.0; K=1.0;

  // --------- build consistent P1 mass weights ML ----------
  int qOrdM = 10;

real Mreal = int2d(Th, qforder=qOrdM)(rho0h);
real M0    = Mreal;

real M0h = 0.0;
BezierMassP3(rho0h, M0h);

real M1h = M0h;

cout << "rho0min = " << rho0min << " rho0max = " << rho0max << endl;
cout << "Target Mass M0h = " << M0h << endl;

real Massh0 = 0.0;
real Massh  = 0.0;
real mResh0 = 0.0;
real mResh  = 0.0;




  // ===== log initial state (k=0) =====
  /*real EkInit = 0.5* int2d(Th, qforder=qOrd)( (sigN*sigN)*(u1n*u1n + u2n*u2n) ); // 动能
  real WorkInit = int2d(Th, qforder=qOrd)( f21Exact(x,y,t) * u1n + f22Exact(x,y,t) * u2n  ); // 势能 int ρ g y
  real ErefInit = EkInit ;
  real EmodInit = EkInit + 1/alpha*1.0 - 1/alpha*1.0;// 修正能量
  ErefPrev = EmodInit;*/

  //real Massh0 = 0.0; for (int i=0;i<Sh.ndof;++i) Massh0 += ML[i]*rho[][i];
  //real mResh0 = Massh0 - M1h;
  //real rhoMinInit = rho[].min;

// ===== log initial state (k=0) =====
  kIdx = 0;
  real Ehatn = 0.0;
  real TEg = 0.0;
  if (lev == L-1) {
  real EkInit = 0.5* int2d(Th, qforder=qOrd)( (sig*sig)*(u1n*u1n + u2n*u2n) ); 
  //real WorkInit = int2d(Th, qforder=qOrd)( f21Exact(x,y,t) * u1n + f22Exact(x,y,t) * u2n  );
  real Ehat = 0.5*EkInit 
           + 0.25*int2d(Th, qforder=qOrd)( sqr(2*sig*u1n - sigN*u1nm1) + sqr(2*sig*u2n - sigN*u2nm1) )
		   +1.0/(2.0*alpha)*( (3*MTF-Mn) ) + 0.25 * int2d(Th, qforder=qOrd)( 
                 sqr(sig*u1n - sigN*u1nm1) + 
                 sqr(sig*u2n - sigN*u2nm1) 
             ); 
   Ehatn = Ehat;
  real Ehatu = 0.5*EkInit 
           + 0.25*int2d(Th, qforder=qOrd)( sqr(2*sig*u1n - sigN*u1nm1) + sqr(2*sig*u2n - sigN*u2nm1) )
		   + 0.25 * int2d(Th, qforder=qOrd)( 
                 sqr(sig*u1n - sigN*u1nm1) + 
                 sqr(sig*u2n - sigN*u2nm1) 
             );
  real Mnms = 1.0/(2.0*alpha)*( (3*MTF-Mn) );
  real ErefInit = EkInit ;
  //real EmodInit = EkInit + 1/alpha*1.0 - 1/alpha*1.0;
  //ErefPrev = EmodInit;
  real Eg = 0.0; Eg = int2d(Th, qforder=qOrd)( dt*f21Exact(x,y,t)*u1n + dt*f22Exact(x,y,t)*u2n);
  TEg = 0.0; //TEg += int2d(Th, qforder=qOrd)( dt*f22Exact(rho0h)*u2hat);

  BezierMassP3(rho, Massh0);
  mResh0 = Massh0 - M0h;
  //real rhoMinInit = rho[].min;
  //real rhoMaxInit = rho[].max;
  RhoPhysicalMinMax(rho, rhoPhysMin, rhoPhysMax);
  real Diss = -2.0*int2d(Th, qforder=qOrd)(
               (muExact(x,y,t))*( sqr(dx(u1n)) + sqr(dy(u2n))
			    + 2.0*sqr( 0.5*(dx(u2n)+dy(u1n)) ) ) );
  real DE = ( Ehat - Ehatn - dt*Diss - Eg );


  fTS << kIdx << "\t" << t
      << "\t" << Massh0
	   << "\t" << mResh0
	   << "\t" << MTF-1.0
	   << "\t" << rhoPhysMin
	   << "\t" << rhoPhysMax
      << "\t" << Ehat
	   << "\t" << ErefInit
	   << "\t" << Eg
      << "\t" << Diss << "\t" << DE << "\t" << MTF/alpha 
	  << "\t" << TEg << "\t" << Mnms << "\t" << Ehatu << "\n";
 }



  // SUPG parameter
  real epsU = 1e-12;

  // ===== Start-up (IMEX-1) =====
  t += dt;
   
 
   
  // Step 1: density (IMEX-1 + SUPG)
  //divUnF = dx(u1nRT) + dy(u2nRT);
  uMagK  = sqrt(u1n*u1n + u2n*u2n) + epsU;
  //tauK   = 1.0 / sqrt( sqr(1.0/dt) + sqr( 2.0*uMagK/hK ) );
  real Cgamma = 200;
  gammaGD = Cgamma * hK * rhoN * (uMagK + 1e-6);
  //gammaGD = 0.0;

int rvOrder = min(3, 0);
if (rvOrder < 1){ rvOrder = 1;}
    real tRv = t - dt;
    muF = muExact(x,y,tRv);
     f1RV = f21Exact(x,y,tRv);
    f2RV = f22Exact(x,y,tRv);
    
    ComputeResidualViscosity(
        Th, S2h,
        u1n, u2n, pn, rhoN,
        muF,
         f1RV, f2RV,
        u1nm1, u2nm1, rhoNm1,
        u1nm2, u2nm2, rhoNm2,
        u1nm3, u2nm3, rhoNm3,
        dt, Cflat, Cmax, hRV,
        histInfRhoU, histInfRhoUU, histInfU,
        Kappa, AlphaFinal,
         RatioRho, RatioMom, RatioDiv, AlphaRaw,1,rvOrder
    );

    

  solve RhotildeSys1( rhotilde , qs, solver=UMFPACK ) =
        int2d(Th,qforder=10)(
            (rhotilde/dt)*qs
          - rhotilde * (u1n*dx(qs) + u2n*dy(qs))
		  //- 0.5*rhotilde*( dx(u1nRT)+dy(u2nRT) )*qs
          /*+ tauK * (u1nRT*dx(qs) + u2nRT*dy(qs)) *
             ( (rhotilde/dt)
             + (u1nRT*dx(rhotilde) + u2nRT*dy(rhotilde))
             + divUnF * rhotilde  )*/
/*+ nudc * (
     dx(rhotilde)*dx(qs) + dy(rhotilde)*dy(qs)
     - 0.0*(uMagK > uCutoff) * ( // 0.5 0  0.2  1.0   
         ( (u1nRT*dx(rhotilde) + u2nRT*dy(rhotilde)) * (u1nRT*dx(qs) + u2nRT*dy(qs)) )
           /(uMagK*uMagK + 1e-20)  
       )
  )*/

     /*+ int1d(Th,1,qforder=8)(
         rhotilde * (u1nRT*N.x + u2nRT*N.y) * qs
       ) */ 

       + Kappa * (
     dx(rhotilde)*dx(qs) + dy(rhotilde)*dy(qs)
      )
        )
       + int1d(Th,1,qforder=10)(
      max(u1n*N.x + u2n*N.y, 0.0) * rhotilde * qs
  )
+ int1d(Th,1,qforder=10)(
      min(u1n*N.x + u2n*N.y, 0.0) * rhoExact(x,y,t) * qs
  ) 
    
    /*- int2d(Th,qforder=8)(
        Kappa * (
              rhodx(x,y,t)*dx(qs)
            + rhody(x,y,t)*dy(qs)
          )
      )*/
      // outflow: u dot n > 0, use unknown rhotilde
      - int2d(Th,qforder=10)(
            (rhotildeN/dt)*qs
          //+ tauK*(u1nRT*dx(qs) + u2nRT*dy(qs)) * (rhotildeN/dt )
        );


  // structure-preserving projection at startup (discrete mass inner product)
  {
    real Fproj = 0.0;

    BezierMassProjectClipP3(
      rhotilde, 
      rho, 
      rho0min, 
      rho0max, 
      M0h,
      xi, 
      xiIters,
      Fproj   
    );

    /*cout << " Iterations number = " << xiIters
         << " , F = " << Fproj
         << " , xi = " << xi << endl;*/
  if (lev == L-1) {
    fN << t << "\t" << xiIters << "\t" << Fproj << "\t" << xi << "\n";
  }

    sig = sqrt(rho);
}
  // discrete mass check at startup
  BezierMassP3(rho, Massh);
 mResh = Massh - M1h;
  

  /*cout << "[lev " << lev << "] k=0"
       << " t=" << t
       << " xiIters=" << xiIters
       << " Massh0_h=" << Massh0 
       << " massRes_h=" << mResh0
       << " rho_min=" << rho0min << endl;*/

  muF = muExact(x,y,t);


  // Step 1b: momentum (IMEX-1)
  solve MomSys1([uhat1,uhat2,p],[uu1,uu2,pp]) =
      int2d(Th,qforder=10)(
          ((sig*sig)/dt) * (uhat1*uu1 + uhat2*uu2)
		+ Mn*muF*Grad(uhat1,uhat2)'*Grad(uu1,uu2)
		+  ConvSkew(rho, u1n, u2n, uhat1, uhat2, uu1, uu2)
        - p*div(uu1, uu2) + pp*div(uhat1,uhat2)
        + p*pp*epsp
        + gammaGD * div(uhat1,uhat2) * div(uu1,uu2)
      )
    + on(1, uhat1=u1Exact(x,y,t), uhat2=u2Exact(x,y,t))
     + int2d(Th,qforder=10)(
              betaU * Kappa * rho * (
                  2.0 * dx(uhat1)*dx(uu1) + 2.0 * dy(uhat2)*dy(uu2)
                + (dy(uhat1) + dx(uhat2)) * (dy(uu1) + dx(uu2))
              )
          )
     + int2d(Th,qforder=10)(
        // === f_rho \cdot (\nabla u \cdot v) ===
        -Kappa * dx(rho) * (uu1 * dx(uhat1) + uu2 * dx(uhat2)) + 
        -Kappa * dy(rho) * (uu1 * dy(uhat1) + uu2 * dy(uhat2))
        
        // === -1/2 f_rho \cdot \nabla(u \cdot v) ===
        + 0.5 * Kappa * dx(rho) * (dx(uhat1)*uu1 + uhat1*dx(uu1) + dx(uhat2)*uu2 + uhat2*dx(uu2))
        + 0.5 * Kappa * dy(rho) * (dy(uhat1)*uu1 + uhat1*dy(uu1) + dy(uhat2)*uu2 + uhat2*dy(uu2))
    )
    - int2d(Th,qforder=10)(
          ((sig*sigN)/dt) * (u1n*uu1 + u2n*uu2) 
        //- Kn * ConvSkew(rho, u1n, u2n, u1n, u2n, uu1, uu2)		
         + Mn * convone(muF,u1n,u2n,uu1,uu2)	 	
       + f21Exact(x,y,t)*uu1 + f22Exact(x,y,t)*uu2 );

  // M update at startup
  real BM0 = int2d(Th, qforder=10)(
              2.0 * muF * (
            e11(uhat1, uhat2) * e11(uhat1, uhat2) + 
            e22(uhat1, uhat2) * e22(uhat1, uhat2) +  
            2.0 * e12(uhat1, uhat2) * e12(uhat1, uhat2) 
               )
             ) ;
  real BM1 = int2d(Th, qforder=10)(
              - muF*Grad(uhat1,uhat2)'*Grad(uhat1,uhat2)
               + convone(muF,u1n, u2n, uhat1, uhat2)
             ) ;
  M = Mn + dt * alpha *( -1*BM0 - Mn * BM1);
  real Merr = abs(M - 1.0);
  MerrSup = max(MerrSup, Merr);
//  MerrL2  += sqr(Merr) * dt;
  real Merr1 = (M - 1.0);
  
 
  
// ===== energy diagnostics at k = 1 =====
  /*real Work0 = int2d(Th, qforder=qOrd)( f21Exact(x,y,t) * uhat1 + f22Exact(x,y,t) * uhat2  );
  real Ekin0 = 0.5* int2d(Th, qforder=qOrd)( (sig*sig)*(uhat1*uhat1 + uhat2*uhat2) );
  real Eref0 = Ekin0 ;
  real Emod = Ekin0 + (1.0/(alpha))*K - 1/alpha;

  real Diss0 = int2d(Th, qforder=qOrd)(
    muF * ( dx(uhat1)*dx(uhat1) + dy(uhat1)*dy(uhat1)
          + dx(uhat2)*dx(uhat2) + dy(uhat2)*dy(uhat2) ) ) - Work0;

  real Eres0 = (Emod - ErefPrev)/dt + Diss0;*/

  // ===== energy diagnostics at k = 1 =====
  //[uTF1,uTF2,pTF] = [u1hat,u2hat,p];
  uTF1 = uhat1;
  uTF2 = uhat2;
  MTF = M;
   kIdx = 1;
   if (lev == L-1) {
  real EkInit = 0.5* int2d(Th, qforder=qOrd)( (sig*sig)*(uTF1*uTF1 + uTF2*uTF2) ); 
  //real WorkInit = int2d(Th, qforder=qOrd)( f21Exact(x,y,t) * u1n + f22Exact(x,y,t) * u2n  );
  real Ehat = 0.5*EkInit 
           + 0.25*int2d(Th, qforder=qOrd)( sqr(2*sig*uTF1 - sigN*u1n) + sqr(2*sig*uTF2 - sigN*u2n) )
		   +1.0/(2.0*alpha)*( (3*MTF-Mn) ) + 0.25 * int2d(Th, qforder=qOrd)( 
                 sqr(sig*uTF1 - sigN*u1n) + 
                 sqr(sig*uTF2 - sigN*u2n) 
             ); 
  real ErefInit = EkInit ;
  real Mnms = 1.0/(2.0*alpha)*( (3*MTF-Mn) );
  real Ehatu = 0.5*EkInit 
           + 0.25*int2d(Th, qforder=qOrd)( sqr(2*sig*uTF1 - sigN*u1n) + sqr(2*sig*uTF2 - sigN*u2n) )
		   + 0.25 * int2d(Th, qforder=qOrd)( 
                 sqr(sig*uTF1 - sigN*u1n) + 
                 sqr(sig*uTF2 - sigN*u2n) 
             );
  //real EmodInit = EkInit + 1/alpha*1.0 - 1/alpha*1.0;
  //ErefPrev = EmodInit;
  real Eg = 0.0; Eg = int2d(Th, qforder=qOrd)( dt*f21Exact(x,y,t)*uhat1 + dt*f22Exact(x,y,t)*uhat2);
  TEg = 0.0; TEg += int2d(Th, qforder=qOrd)( dt*f21Exact(x,y,t)*uhat1 + dt*f22Exact(x,y,t)*uhat2);

  BezierMassP3(rho, Massh0);
  mResh0 = Massh0 - M0h;
  //rhoMinInit = rho[].min;
  //rhoMaxInit = rho[].max;
  RhoPhysicalMinMax(rho, rhoPhysMin, rhoPhysMax);
   real Diss = -2.0*int2d(Th, qforder=qOrd)(
               (muExact(x,y,t))*( sqr(dx(uTF1)) + sqr(dy(uTF2))
			    + 2.0*sqr( 0.5*(dx(uTF2)+dy(uTF1)) ) ) );
   real DE = ( Ehat - Ehatn - dt*Diss - Eg );


  fTS << kIdx << "\t" << t
      << "\t" << Massh0
	   << "\t" << mResh0
	   << "\t" << MTF-1.0
	   << "\t" << rhoPhysMin
	   << "\t" << rhoPhysMax
      << "\t" << Ehat
	   << "\t" << ErefInit
	   << "\t" << Eg
      << "\t" << Diss << "\t" << DE << "\t" << MTF/alpha 
	  << "\t" << TEg << "\t" << Mnms << "\t" << Ehatu << "\n";

  // roll histories
  Ehatn = Ehat;
    }
  //ErefPrev = Emod;
  /*fStep << lev << "\t" << 0 << "\t" << t << "\t" << Nx << "\t" << Nt
        << "\t" << xiIters << "\t" << rhoMin << "\t" << rhoMax
        << "\t" << mResh 
		<< "\t" << M  << "\t" << Merr1 << "\t" << K  << "\t" << Kerr1 << "\t" << xi << "\t" << Massh << "\n";*/

  // roll histories
  u1nm3 = u1nm2; u2nm3 = u2nm2;
  u1nm2 = u1nm1; u2nm2 = u2nm1;
  u1nm1 = u1n; u2nm1 = u2n;
  u1n   = uhat1;  u2n   = uhat2;
  pnm1[] = pn[]; pn[] = p[];
  sigNm1 = sigN; sigN = sig;
  Mnm1 = Mn; Mn = M;
  rhoNm3 = rhoNm2;
  rhoNm2 = rhoNm1; rhoNm1 = rhoN; rhoN = rho;
  rhotildeNm1 = rhotildeN; rhotildeN = rho;


  // ===== main time loop (BDF2) =====
  for (int k=1; k<Nt; ++k){
    t += dt;
    if (k % 20 == 0) {cout << "[lev " << lev << "] k=" << k
         << " t=" << t
         << " dt=" << dt
         << " Nx=" << Nx
         << endl;}
    u1star = 2.0*u1n - u1nm1;
    u2star = 2.0*u2n - u2nm1;
    real Mstar = 2.0*Mn - Mnm1;
  
   /*real fluxWallL2 = sqrt(
    int1d(Th,1,qforder=8)(
        sqr(u1starRT*N.x + u2starRT*N.y)
    )
);
cout << "[boundary flux check]"
     << " t=" << t
     << " FluxL2=" << fluxWallL2
     << endl;*/
	
	/* weak divergence residual norm for RT1 velocity (u1,u2) */
	/*divuRT = dx(u1starRT) + dy(u2starRT);
real divMinRT = divuRT[].min;
real divMaxRT = divuRT[].max;
real divL2RT = sqrt( int2d(Th)( divuRT^2 ) );

cout << "   RT ustar divL2 = " << divL2RT
    // << " , weakdivnorm = " << normWeak0  
     << " ,  min(div(u))_RT ustar =   " << divMinRT
     << " ,  max(div(u))_RT ustar = " << divMaxRT << endl;*/


    // Step 1: density (BETF + SUPG)
    //divUnF = dx(u1starRT) + dy(u2starRT);
    uMagK  = sqrt(u1star*u1star + u2star*u2star) + 1e-12;
    //tauK   = 1.0 / sqrt( sqr(1.0/dt) + sqr( 2.0*uMagK/hK ) );   //BDF1 1.0/dt  BDF2  1.5/dt
    gammaGD = Cgamma * hK * rhoN * (uMagK + 1e-6);
	//gammaGD = 0.0;


   rvOrder = min(3, k);
if (rvOrder < 1){ rvOrder = 1;}
    real tRv = t - dt;
    muF = muExact(x,y,tRv);
     f1RV = f21Exact(x,y,tRv);
    f2RV = f22Exact(x,y,tRv);

    
    ComputeResidualViscosity(
        Th, S2h,
        u1n, u2n, pn, rhoN,
        muF,
          f1RV,
          f2RV,
        u1nm1, u2nm1, rhoNm1,
        u1nm2, u2nm2, rhoNm2,
        u1nm3, u2nm3, rhoNm3,
        dt, Cflat, Cmax, hRV,
        histInfRhoU, histInfRhoUU, histInfU,
        Kappa, AlphaFinal,
         RatioRho, RatioMom, RatioDiv, AlphaRaw,k,rvOrder
    );

    solve RhotildeSys2(rhotilde, qs, solver=UMFPACK) =
        int2d(Th,qforder=10)(
            (1.0/(dt)) * rhotilde * qs
          - rhotilde * (u1star*dx(qs) + u2star*dy(qs))
		   //-0.5*rhotilde*( dx(u1starRT)+dy(u2starRT) )*qs
          /*+ tauK * (u1starRT*dx(qs) + u2starRT*dy(qs)) *
              ( (1.0/(dt)) * rhotilde
			  //(3.0/(2.0*dt)) * rhotilde
              + (u1starRT*dx(rhotilde) + u2starRT*dy(rhotilde))
              + divUnF * rhotilde  )*/
/*+ nudc * (
     dx(rhotilde)*dx(qs) + dy(rhotilde)*dy(qs)
     - 0.0*(uMagK > uCutoff) * ( // 0.5 0.2  1.0
          ( (u1starRT*dx(rhotilde) + u2starRT*dy(rhotilde))* (u1starRT*dx(qs) + u2starRT*dy(qs)) )
            /(uMagK*uMagK + 1e-20) 
       )
  )*/
        + Kappa * (
     dx(rhotilde)*dx(qs) + dy(rhotilde)*dy(qs)
  )
        )
      /*+ int1d(Th,1,qforder=8)(
         rhotilde * (u1starRT*N.x + u2starRT*N.y) * qs
       )*/
       + int1d(Th,1,qforder=10)(
      max(u1star*N.x + u2star*N.y, 0.0) * rhotilde * qs
  )
+ int1d(Th,1,qforder=10)(
      min(u1star*N.x + u2star*N.y, 0.0) * rhoExact(x,y,t) * qs
  )
  
      /*- int2d(Th,qforder=8)(
        Kappa * (
              rhodx(x,y,t)*dx(qs)
            + rhody(x,y,t)*dy(qs)
          )
      )*/
      - int2d(Th,qforder=10)(
            ((1.0*rhotildeN )/(dt)) * qs
          /*+ tauK * (u1starRT*dx(qs) + u2starRT*dy(qs)) *
              ( (1.0*rhotildeN )/(dt)  )*/
			  //( (4.0*rhotildeN - rhotildeNm1)/(2.0*dt)  )
        );
		
	//time filter for \rhotilde to \rhotildehat 
	rhotildehat = rhotilde - ( rhotilde - 2.0*rhotildeN + rhotildeNm1 )/3.0;

    //cout << "nudc max value = " << nudc[].max << " min value = " << nudc[].min << endl;
	//cout << "gammaGD max value = " << gammaGD[].max << " min value = " << gammaGD[].min << endl;

    // projection (BDF2) with discrete mass inner product
    {
    real Fproj = 0.0;
    BezierMassProjectClipP3(
      rhotildehat, 
      rho, 
      rho0min, 
      rho0max, 
      M0h,
      xi, 
      xiIters,
      Fproj   
    );


    /*cout << " Iterations number = " << xiIters
         << " , F = " << Fproj
         << " , xi = " << xi << endl;*/
    
 if (lev == L-1) {
   fN << t << "\t" << xiIters << "\t" << Fproj << "\t" << xi << "\n";
 }

    sig = sqrt(rho);
}
	
  
  muF = muExact(x,y,t);

    // momentum (BDF2)
     solve MomSys2([uhat1,uhat2,p],[uu1,uu2,pp]) =
        int2d(Th,qforder=10)(
            (1.0/(dt))*(sig*sig) * (uhat1*uu1 + uhat2*uu2)
			+ Mstar*muF*Grad(uhat1,uhat2)'*Grad(uu1,uu2)
			+ ConvSkew(rho, u1star, u2star, uhat1, uhat2, uu1, uu2)
          - p*div(uu1,uu2) + pp*div(uhat1,uhat2)
          + p*pp*epsp
          + gammaGD * div(uhat1,uhat2) * div(uu1,uu2)
        )
      + on(1, uhat1=u1Exact(x,y,t), uhat2=u2Exact(x,y,t))
      + int2d(Th,qforder=10)(
              betaU * Kappa * rho * (
                  2.0 * dx(uhat1)*dx(uu1) + 2.0 * dy(uhat2)*dy(uu2)
                + (dy(uhat1) + dx(uhat2)) * (dy(uu1) + dx(uu2))
              )
          )
     + int2d(Th,qforder=10)(
        // === f_rho \cdot (\nabla u \cdot v) ===
        -Kappa * dx(rho) * (uu1 * dx(uhat1) + uu2 * dx(uhat2)) + 
        -Kappa * dy(rho) * (uu1 * dy(uhat1) + uu2 * dy(uhat2))
        
        // === -1/2 f_rho \cdot \nabla(u \cdot v) ===
        + 0.5 * Kappa * dx(rho) * (dx(uhat1)*uu1 + uhat1*dx(uu1) + dx(uhat2)*uu2 + uhat2*dx(uu2))
        + 0.5 * Kappa * dy(rho) * (dy(uhat1)*uu1 + uhat1*dy(uu1) + dy(uhat2)*uu2 + uhat2*dy(uu2))
    )
      - int2d(Th,qforder=10)(
            ( (sig*(1.0*sigN*u1n )/(dt)) ) * uu1
          + ( (sig*(1.0*sigN*u2n )/(dt)) ) * uu2 
		  //- Kstar * ConvSkew(rho, u1star, u2star, u1star, u2star, uu1, uu2) 
       + Mstar * convone(muF, u1star, u2star, uu1, uu2) 
          + f21Exact(x,y,t)*uu1 + f22Exact(x,y,t)*uu2
        );

   /* divutilde = dx(uhat1) + dy(uhat2);
   real divMintilde = divutilde[].min;
   real divMaxtilde = divutilde[].max;
   real divL2tilde = sqrt( int2d(Th)( divutilde^2 ) );

cout << "  Non TF u divL2 = " << divL2tilde
    // << " , weakdivnorm = " << normWeak0  
     << " ,  min(div(u))_Non TF u =   " << divMintilde
     << " ,  max(div(u))_Non TF u = " << divMaxtilde << endl;		
    		
    varf vCheckDiv(unused, q) = int2d(Th)( q * (dx(uhat1) + dy(uhat2)) );


real[int] divResidual = vCheckDiv(0, Qh);

cout << "NonTF Weak form divergence residual (Max) = " << divResidual.linfty << endl;
cout << "NonTF Weak form divergence residual (L2)  = " << divResidual.l2 << endl;*/
    
	// time filter for u and p to uhat and pTF
	w1 = sig * uhat1; w2 = sig * uhat2;
	what1 = w1 - ( w1 - 2.0*sigN*u1n + sigNm1*u1nm1 )/3.0;
	what2 = w2 - ( w2 - 2.0*sigN*u2n + sigNm1*u2nm1 )/3.0;
	uTF1 = what1/sig;
	uTF2 = what2/sig;
	//uTF1 = uhat1 - ( uhat1 - 2.0*u1n + u1nm1 )/3.0;
	//uTF2 = uhat2 - ( uhat2 - 2.0*u2n + u2nm1 )/3.0;
	//pTF = p - ( p - 2.0*pn + pnm1 )/3.0;
	pTF = p;

   /*divuRT = dx(uTF1) + dy(uTF2);
   real divMinRT = divuRT[].min;
   real divMaxRT = divuRT[].max;
   real divL2RT = sqrt( int2d(Th)( divuRT^2 ) );

cout << "  uTF divL2 = " << divL2RT
    // << " , weakdivnorm = " << normWeak0  
     << " ,  min(div(u))_uTF =   " << divMinRT
     << " ,  max(div(u))_uTF = " << divMaxRT << endl;

	varf vCheckDivTF(unused, q) = int2d(Th)( q * (dx(uTF1) + dy(uTF2)) );


real[int] divResidualTF = vCheckDivTF(0, Qh);

cout << "TF Weak form divergence residual (Max) = " << divResidualTF.linfty << endl;
cout << "TF Weak form divergence residual (L2)  = " << divResidualTF.l2 << endl;

	u1True = u1Exact(x,y,t);
	u2True = u2Exact(x,y,t);
	
divuTrue = dx( u1True ) + dy( u2True );
real divMinTrue = divuTrue[].min;
real divMaxTrue = divuTrue[].max;
real divL2True = sqrt( int2d(Th)( divuTrue^2 ) );

cout << "  uTrue divL2 = " << divL2True
    // << " , weakdivnorm = " << normWeak0  
     << " ,  min(div(u))_uTrue =   " << divMinTrue
     << " ,  max(div(u))_uTrue = " << divMaxTrue << endl;	
	
	varf vCheckDivTrue(unused, q) = int2d(Th)( q * ( dx( u1True ) + dy( u2True ) ) );

real[int] divResidualTrue = vCheckDivTrue(0, Qh);

cout << "True Weak form divergence residual (Max) = " << divResidualTrue.linfty << endl;
cout << "True Weak form divergence residual (L2)  = " << divResidualTrue.l2 << endl;*/

    // M update (BDF2)
 real BM0 = int2d(Th, qforder=10)(
               2.0 * muF * (
            e11(uTF1, uTF2) * e11(uTF1, uTF2) +  
            e22(uTF1, uTF2) * e22(uTF1, uTF2) +  
            2.0 * e12(uTF1, uTF2) * e12(uTF1, uTF2) 
               )
             );
  real BM1 = int2d(Th, qforder=10)(
               -muF*Grad(uhat1,uhat2)'*Grad(uhat1,uhat2)
               + convone(muF, u1star, u2star, uhat1, uhat2)
             ) ;
  //M = ( 4*Mn - Mnm1 + 2*dt * alpha * ( BM0 - Mstar * BM1) )/3.0;
   M =  Mn + dt * alpha * ( -1*BM0 - Mstar * BM1) ;
   
   // time fliter for M to MTF
   MTF = M - ( M - 2.0*Mn + Mnm1 )/3.0;

    real MerrStep = abs(MTF - 1.0);
    MerrSup = max(MerrSup, MerrStep);
//    MerrL2  += sqr(MerrStep) * dt;
	real MerrStep1 = (MTF - 1.0);
	
	//cout<< "diffusion term : "<<BM0<<endl;
	

  
 
  
  	  // ===== energy diagnostics at k >=2 =====
   kIdx = k+1;
 if (lev == L-1) {

   real  EkInit = 0.5* int2d(Th, qforder=qOrd)( (sig*sig)*(uTF1*uTF1 + uTF2*uTF2) ); 
  //real WorkInit = int2d(Th, qforder=qOrd)( f21Exact(x,y,t) * u1n + f22Exact(x,y,t) * u2n  );
   real Ehat = 0.5*EkInit 
           + 0.25*int2d(Th, qforder=qOrd)( sqr(2*sig*uTF1 - sigN*u1n) + sqr(2*sig*uTF2 - sigN*u2n) )
		   +1.0/(2.0*alpha)*( (3*MTF-Mn) ) + 0.25 * int2d(Th, qforder=qOrd)( 
                 sqr(sig*uTF1 - sigN*u1n) + 
                 sqr(sig*uTF2 - sigN*u2n) 
             ); 
   real ErefInit = EkInit ;
   real Mnms = 1.0/(2.0*alpha)*( (3*MTF-Mn) );
   real Ehatu = 0.5*EkInit 
           + 0.25*int2d(Th, qforder=qOrd)( sqr(2*sig*uTF1 - sigN*u1n) + sqr(2*sig*uTF2 - sigN*u2n) )
		   + 0.25 * int2d(Th, qforder=qOrd)( 
                 sqr(sig*uTF1 - sigN*u1n) + 
                 sqr(sig*uTF2 - sigN*u2n) 
             ); 
  //real EmodInit = EkInit + 1/alpha*1.0 - 1/alpha*1.0;
  //ErefPrev = EmodInit;
  real Eg = 0.0; Eg = int2d(Th, qforder=qOrd)( dt*f21Exact(x,y,t)*uhat1 + dt*f22Exact(x,y,t)*uhat2);

  TEg += int2d(Th, qforder=qOrd)( dt*f21Exact(x,y,t)*uhat1 + dt*f22Exact(x,y,t)*uhat2);

  BezierMassP3(rho, Massh0);
  mResh0 = Massh0 - M0h;
  //rhoMinInit = rho[].min;
  //rhoMaxInit = rho[].max;
  RhoPhysicalMinMax(rho, rhoPhysMin, rhoPhysMax);
   real Diss = -2.0*int2d(Th, qforder=qOrd)(
               (muExact(x,y,t))*( sqr(dx(uTF1)) + sqr(dy(uTF2))
			    + 2.0*sqr( 0.5*(dx(uTF2)+dy(uTF1)) ) ) );
   real DE = ( Ehat - Ehatn - dt*Diss - Eg );


  fTS << kIdx << "\t" << t
      << "\t" << Massh0
	   << "\t" << mResh0
	   << "\t" << MTF-1.0
	   << "\t" << rhoPhysMin
	   << "\t" << rhoPhysMax
      << "\t" << Ehat
	   << "\t" << ErefInit
	   << "\t" << Eg
      << "\t" << Diss << "\t" << DE << "\t" << MTF/alpha 
	  << "\t" << TEg << "\t" << Mnms << "\t" << Ehatu << "\n";

  // roll histories
    Ehatn = Ehat;
      }


    // history update
    u1nm3 = u1nm2; u2nm3 = u2nm2;
    u1nm2 = u1nm1; u2nm2 = u2nm1;
    sigNm1 = sigN; sigN = sig;
    u1nm1 = u1n; u2nm1 = u2n;
    u1n = uTF1; u2n = uTF2;
    pnm1[] = pn[]; pn[] = pTF[];
    Mnm1 = Mn; Mn = MTF;
	rhoNm3 = rhoNm2;
    rhoNm2 = rhoNm1; rhoNm1 = rhoN; rhoN = rho;
    rhotildeNm1 = rhotildeN; rhotildeN = rho;

 

    /*if ((k+1) % printEvery == 0) { //100 loop
      ffSaveData(uhat1,"utest_t"+t+".txt");
      ffSaveData(uhat2,"vtest_t"+t+".txt");
      ffSaveData(rho,"rhotest_t"+t+".txt");
      cout << "Savedt= " << t << endl;
    } //100 loop*/

    // ===== energy diagnostics for k >= 2 =====
    /*real Work = int2d(Th, qforder=qOrd)( f21Exact(x,y,t) * uhat1 + f22Exact(x,y,t) * uhat2  );
    real Ek = 0.5* int2d(Th, qforder=qOrd)( (sig*sig)*(uhat1*uhat1 + uhat2*uhat2) );
    real Eref = Ek ;
    real L21 = int2d(Th, qforder=qOrd)( (sig*sig)*(uhat1*uhat1 + uhat2*uhat2) ); // ||σ^{n+1} u^{n+1}||^2
    real L22 = int2d(Th, qforder=qOrd)( // ||2σ^{n+1}u^{n+1} - σ^n u^n||^2
                  sqr( 2.0*sig*uhat1 - sigN*u1n )
                + sqr( 2.0*sig*uhat2 - sigN*u2n ) );
    real L2Eu = L21 + L22;
    real Emod = 0.25*(L2Eu) + (1.0/(2.0*alpha))*(3.0*K - Kn) - 1/alpha;

    real Diss = int2d(Th, qforder=qOrd)(
      muF * ( dx(uhat1)*dx(uhat1) + dy(uhat1)*dy(uhat1)
            + dx(uhat2)*dx(uhat2) + dy(uhat2)*dy(uhat2) ) )- Work;

    real Eres = (Emod - ErefPrev)/dt + Diss;

    kIdx++;
    fTS << kIdx << "\t" << t
        << "\t" << Ek
        << "\t" << Work
        << "\t" << Eref
        << "\t" << L2Eu
        << "\t" << Emod
        << "\t" << Diss
        << "\t" << Eres
        << "\t" << Massh
        << "\t" << mResh
        << "\t" << rhoMin
        << "\t" << xiIters
        << "\t" << xi
        << "\t" << M
        << "\t" << abs(M - 1.0) << "\n";

    ErefPrev = Emod;*/

    /*fStep << lev << "\t" << k << "\t" << t << "\t" << Nx << "\t" << Nt
          << "\t" << xiIters << "\t" << rhoMin << "\t" << rhoMax
          << "\t" << mResh 
		  << "\t" << MTF << "\t" << MerrStep1 << "\t" << KTF << "\t" << KerrStep1 << "\t" << xi << "\t" << Massh << "\n";*/

    /*if (abs(t-Tend) < 0.5*dt){
      ffSaveData(uhat1,"utest_t"+t+".txt");
      ffSaveData(uhat2,"vtest_t"+t+".txt");
      ffSaveData(rho,"rhotest_t"+t+".txt");
      cout << "Saved final t= " << t << endl;
    }*/
   } // time loop
   
    
  // ----- errors and rates at final time (per level) -----
    real areaTh = int2d(Th)(1.0);

    Qh ep; ep = pTF - pExact(x,y,t);
    real epmean = int2d(Th)(ep)/areaTh;
    real eL2p = sqrt( int2d(Th, qforder=10)( sqr(ep - epmean) ) );
//	real eH1p = sqrt( int2d(Th, qforder=10)( sqr(ep - epmean) 
//	                                        + sqr(pdx(x,y,t) - dx(pTF)) 
//											+sqr(pdy(x,y,t) - dy(pTF)) ) );

    real eL2u  = sqrt( int2d(Th, qforder=10)( sqr(u1Exact(x,y,t)-uTF1) + sqr(u2Exact(x,y,t)-uTF2) ) );
    real eH1u  = sqrt( int2d(Th, qforder=10)(
         sqr(u1Exact(x,y,t)-uTF1) + sqr(u2Exact(x,y,t)-uTF2)
       + sqr(u1dx(x,y,t)-dx(uTF1)) + sqr(u1dy(x,y,t)-dy(uTF1))
       + sqr(u2dx(x,y,t)-dx(uTF2)) + sqr(u2dy(x,y,t)-dy(uTF2)) ) );
    real eDivL2 = sqrt(
    int2d(Th, qforder=10)(
        sqr(
              (u1dx(x,y,t) + u2dy(x,y,t))
            - (dx(uTF1) + dy(uTF2))
        )
            )
        );

    // Discrete H^{-1} norm of the divergence error.  The auxiliary
    // Poisson problem realizes the dual norm with respect to H_0^1.
    solve DivHm1Problem(phiDivHm1, testDivHm1, solver=UMFPACK) =
          int2d(Th, qforder=10)(
              dx(phiDivHm1)*dx(testDivHm1)
            + dy(phiDivHm1)*dy(testDivHm1)
          )
        - int2d(Th, qforder=10)(
            (
                (u1dx(x,y,t) + u2dy(x,y,t))
              - (dx(uTF1) + dy(uTF2))
            ) * testDivHm1
          )
        + on(1, phiDivHm1=0.0);

    real eDivHm1Sq = int2d(Th, qforder=10)(
          sqr(dx(phiDivHm1)) + sqr(dy(phiDivHm1))
        );
    real eDivHm1 = sqrt(abs(eDivHm1Sq));

    real eL2rho = sqrt( int2d(Th, qforder=10)( sqr(rho - rhoExact(x,y,t)) ) );
//	real eH1rho = sqrt( int2d(Th, qforder=10)( sqr(rho - rhoExact(x,y,t)) 
//	                              + sqr( rhodx(x,y,t) -dx(rho) )
//								  + sqr( rhody(x,y,t) -dy(rho) )  ) );



    real eMinf = MerrSup;
    // Normalized time-L2 error (RMS); keep the existing output convention.
//    real eM2   = sqrt( MerrL2 / (Tend - T0) );

	
	//real eQinf = QerrSup;
    //real eQ2   = sqrt( QerrL2 / (Tend - T0) );

    real rL2u = 0.0, rH1u = 0.0, rL2p = 0.0, rL2rho = 0.0, rMinf = 0.0/*, rM2 = 0.0*/, rKinf = 0.0, rK2 = 0.0;
	real /*rH1p = 0.0, rH1rho = 0.0,*/rQinf = 0.0, rQ2 = 0.0;
    real rDivL2 = 0.0, rDivHm1 = 0.0;
 


    if (lev > 0 && prevDt > 0.0){
      real denom = log(prevDt/dt);
      if (abs(denom) >= 1e-14){
        if (prevL2 > 0.0 && eL2u > 0.0)
          rL2u = log(prevL2/eL2u)/denom;
        if (prevH1 > 0.0 && eH1u > 0.0)
          rH1u = log(prevH1/eH1u)/denom;
        if (prevDivL2 > 0.0 && eDivL2 > 0.0)
          rDivL2 = log(prevDivL2/eDivL2)/denom;
        if (prevDivHm1 > 0.0 && eDivHm1 > 0.0)
          rDivHm1 = log(prevDivHm1/eDivHm1)/denom;
        if (prevP > 0.0 && eL2p > 0.0)
          rL2p = log(prevP/eL2p)/denom;
//        if (prevPH1 > 0.0 && eH1p > 0.0)
//		  rH1p = log(prevPH1/eH1p)/denom;
        if (prevRho > 0.0 && eL2rho > 0.0)
          rL2rho = log(prevRho/eL2rho)/denom;
//        if (prevRhoH1 > 0.0 && eH1rho > 0.0)
//		  rH1rho = log(prevRhoH1/eH1rho)/denom;
        if (prevMInf > 0.0 && eMinf > 0.0)
          rMinf = log(prevMInf/eMinf)/denom;
//        if (prevM2 > 0.0 && eM2 > 0.0)
//          rM2 = log(prevM2/eM2)/denom;

      
		//rKinf  = log( prevKInf / eKinf )   / denom;
        //rK2    = log( prevK2   / eK2 )     / denom;
		//rQinf  = log( prevQInf / eQinf )   / denom;
        //rQ2    = log( prevQ2   / eQ2 )     / denom;
      }
    }

    cout << "[lev " << lev << "] Nx=" << Nx
     << " Nt=" << Nt
     << " dt=" << dt
     << " h=" << h
     << " eL2u=" << eL2u
     << " eH1u=" << eH1u
     << " eDivL2=" << eDivL2
     << " eDivHm1=" << eDivHm1
     << " eL2p=" << eL2p
//     << " eH1p=" << eH1p
     << " eL2rho=" << eL2rho
//     << " eH1rho=" << eH1rho
     << " eMinf=" << eMinf
//     << " eM2=" << eM2
     << endl;



		 //<< "  eKinf="<<eKinf<<" eK2="<<eK2 << endl;
		 //<< "  eQinf="<<eQinf<<" eQ2="<<eQ2 << endl;

    cout << "rates (time only): "
     << " ruL2="    << rL2u
     << ", ruH1="   << rH1u
     << ", rdivL2=" << rDivL2
     << ", rdivHm1=" << rDivHm1
     << ", rpL2="   << rL2p
//     << ", rpH1="   << rH1p
     << ", rrhoL2=" << rL2rho
//     << ", rrhoH1=" << rH1rho
     << ", rMinf="  << rMinf
//     << ", rM2="    << rM2
     << endl; 
		 //<< ", rKinf=" << rKinf
         //<< ", rK2="   << rK2 << endl; 
		 //<< ", rQinf=" << rQinf
         //<< ", rQ2="   << rQ2 << endl;


         

     fupK << Nx  << "\t&\t" << Nt  << "\t&\t" << h << "\t&\t" << dt
     << "\t&\t" << eL2u   << "\t&\t" << rL2u
     << "\t&\t" << eH1u   << "\t&\t" << rH1u
     << "\t&\t" << eDivL2 << "\t&\t" << rDivL2
     << "\t&\t" << eDivHm1 << "\t&\t" << rDivHm1
     << "\t&\t" << eL2p   << "\t&\t" << rL2p
//     << "\t&\t" << eH1p   << "\t&\t" << rH1p
     << "\t&\t" << eL2rho << "\t&\t" << rL2rho
//     << "\t&\t" << eH1rho << "\t&\t" << rH1rho
     << "\t&\t" << eMinf  << "\t&\t" << rMinf
//     << "\t&\t" << eM2    << "\t&\t" << rM2
     << "\t\\ \\hline" << endl;
fupK.flush;




    // store for next level
    prevDt = dt;
    prevL2   = eL2u;
    prevH1   = eH1u;
    prevDivL2 = eDivL2;
    prevDivHm1 = eDivHm1;
    prevP    = eL2p;
//	prevPH1    = eH1p;
    prevRho  = eL2rho;
//	prevRhoH1  = eH1rho;
    prevMInf = eMinf;
//    prevM2   = eM2;
	//prevKInf = eKinf;
    // prevK2   = eK2;
	//prevQInf = eQinf;
    //prevQ2   = eQ2;
    prevNT   = Nt;

      /*ffSaveVh(Th,Sh,"fespace_Sh"+lev+".txt");
	  savemesh(Th, "NS_BP_TF_PnonTF"+lev+".msh");
      ffSaveData(rho,"rhotest_t"+lev+".txt");
      cout << "Saved final lev= " << lev  << "  t= " << t  << endl;*/
   






		 //<< "  eKinf="<<eKinf<<" eK2="<<eK2 << endl;
		 //<< "  eQinf="<<eQinf<<" eQ2="<<eQ2 << endl;

		 //<< ", rKinf=" << rKinf
         //<< ", rK2="   << rK2 << endl; 
		 //<< ", rQinf=" << rQinf
         //<< ", rQ2="   << rQ2 << endl;


 
    // prevNX = Nx; // keep for spatial rates if needed
} // refinement loop

real totalCpuSeconds = clock() - totalCpuStart;
cout << "[timing] total_cpu_seconds=" << totalCpuSeconds << endl;
fupK << "% total_cpu_seconds=" << totalCpuSeconds << endl;
fupK.flush;
