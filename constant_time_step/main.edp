/* ===============================================================
 Variable-density NS on unit disk with SUPG for density
  Convergence tests (manufactured solution)
=============================================================== */
include "ffmatlib.idp"
load "UMFPACK64"
load "Element_Mixte"
load "Element_P3"
include "NewViscosity.idp"

// ---------- parameters ----------
real T0 = 0.0, Tend = 0.4; //new1
int  L  = 4;          // refinement levels
int  NxFixed = 800;   // fixed boundary points for unit circle mesh
int  Nt0 = 10;   
int  printEvery = 999999;
int  Itenum = 1e3;    // max iterations for projection

real alpha = 1e-3; // alpha for K updates
real tol  = 0.5e-13;    // tolerance for projection Newton

// initial scalars
real Mn = 1.0, M=1.0;
real Kn = 1.0, K=1.0;
real Qn = 1.0, Q=1.0;
real  MTF=1.0;
real  KTF=1.0;
real  QTF=1.0;
int  kIdx = 0;
real ErefPrev = 0.0;

/* Kappa Parameters */
real Cflat = 0.1;
real Cmax = 1.0;
real betaU = 1.0;

real histInfRhoU  = 1.0e-16;
real histInfRhoUU = 1.0e-16;
real histInfU     = 1.0e-16;



// ---------- exact / manufactured solution ----------
real epsRho = 0.2;

func real qsw(real x, real y){
    return 1.0 - x*x - y*y;
}

func real rhoExact(real x, real y, real t){
    real B = qsw(x,y)*sin(t);
    return 2.0 + epsRho*( x*cos(B) + y*sin(B) );
}

func real rhodx(real x, real y, real t){
    real B  = qsw(x,y)*sin(t);
    real Bx = -2.0*x*sin(t);
    return epsRho*( cos(B) + Bx*(-x*sin(B) + y*cos(B)) );
}

func real rhody(real x, real y, real t){
    real B  = qsw(x,y)*sin(t);
    real By = -2.0*y*sin(t);
    return epsRho*( sin(B) + By*(-x*sin(B) + y*cos(B)) );
}

func real u1Exact(real x, real y, real t){
    return -y*qsw(x,y)*cos(t);
}

func real u2Exact(real x, real y, real t){
    return x*qsw(x,y)*cos(t);
}

func real pExact(real x, real y, real t){
    return sin(x)*sin(y)*sin(t);
}

// velocity derivatives
func real u1dx(real x, real y, real t){
    return 2.0*x*y*cos(t);
}

func real u1dy(real x, real y, real t){
    return (-1.0 + x*x + 3.0*y*y)*cos(t);
}

func real u2dx(real x, real y, real t){
    return (1.0 - 3.0*x*x - y*y)*cos(t);
}

func real u2dy(real x, real y, real t){
    return -2.0*x*y*cos(t);
}

// pressure derivatives
func real pdx(real x, real y, real t){
    return cos(x)*sin(y)*sin(t);
}

func real pdy(real x, real y, real t){
    return sin(x)*cos(y)*sin(t);
}

// viscosity 

real epsR1 = 1e-8;


real muMin = 0.1; 
real Amp = 1.0; 
func real muExact(real x, real y, real t){ 
         //0.995 1.015  
         real r2 = x*x + y*y; 
       return muMin + Amp * r2 * (1.0 + sin(t));
	   //real Re = 100.0;
       //return  1.0/Re;   
}




// ---------- body force (includes grad p) ----------
func real mudx(real x, real y, real t){
    return 2.0*Amp*x*(1.0 + sin(t));
}

func real mudy(real x, real y, real t){
    return 2.0*Amp*y*(1.0 + sin(t));
}

func real f21Exact(real x, real y, real t){
    real rho = rhoExact(x,y,t);
    real q   = qsw(x,y);
    real ct  = cos(t);
    real st  = sin(t);

    real mu  = muExact(x,y,t);
    real mux = mudx(x,y,t);
    real muy = mudy(x,y,t);

    // u_t + u · grad u
    real acc1 = y*q*st - x*q*q*ct*ct;

    // D11 = 2 u1x, D12 = u1y + u2x
    real D11 = 4.0*x*y*ct;
    real D12 = 2.0*(y*y - x*x)*ct;

    // div( mu*(grad u + grad u^T) )_1
    real divStress1 = 8.0*mu*y*ct + mux*D11 + muy*D12;

    return rho*acc1 - divStress1 + pdx(x,y,t);
}

func real f22Exact(real x, real y, real t){
    real rho = rhoExact(x,y,t);
    real q   = qsw(x,y);
    real ct  = cos(t);
    real st  = sin(t);

    real mu  = muExact(x,y,t);
    real mux = mudx(x,y,t);
    real muy = mudy(x,y,t);

    // u_t + u · grad u
    real acc2 = -x*q*st - y*q*q*ct*ct;

    // D12 = u1y + u2x, D22 = 2 u2y
    real D12 = 2.0*(y*y - x*x)*ct;
    real D22 = -4.0*x*y*ct;

    // div( mu*(grad u + grad u^T) )_2
    real divStress2 = -8.0*mu*x*ct + mux*D12 + muy*D22;

    return rho*acc2 - divStress2 + pdy(x,y,t);
}



// ---------- macros ----------
macro Grad(u1,u2) [dx(u1), dy(u1), dx(u2), dy(u2)]//
macro div(u1,u2)  (dx(u1) + dy(u2))//
macro e11(u1, u2) dx(u1) // 
macro e22(u1, u2) dy(u2) // 
macro e12(u1, u2) (0.5 * (dy(u1) + dx(u2))) //
// Convective skew form
macro ConvSkew(rho,a1,a2,b1,b2,V1,V2)
( (rho)*(a1*dx(b1)+a2*dy(b1))*V1
+ (rho)*(a1*dx(b2)+a2*dy(b2))*V2
+ 0.5*( dx(rho)*a1 + (rho)*dx(a1) + dy(rho)*a2 + (rho)*dy(a2) )*( b1*V1 + b2*V2 ) ) //

/*macro ConvSkew1(rho,a1,a2,b1,b2,V1,V2)
( (rho)*(a1*dx(b1)+a2*dy(b1))*V1
+ (rho)*(a1*dx(b2)+a2*dy(b2))*V2
+ 0.25*( (rho)*dx(a1) + (rho)*dy(a2) )*( b1*V1 + b2*V2 ) ) //*/

macro convone(mu,b1,b2,v1,v2)
( ( dx(b1)*dx(mu) + dx(b2)*dy(mu) )*v1 + ( dy(b1)*dx(mu) + dy(b2)*dy(mu) )*v2 )//




real epsp = 1e-10;   // pressure stabilization
//real gammaGD = 0.0;  // optional grad-div
real tinyDrag = 0.0; // optional linear drag

// ---------- I/O ----------
ofstream fupK ("./NS_BP_QM_TF_PnonTF_PH1_rhoH1.txt");  // M2 epsXY0.01    M30.005
//ofstream fStep("rhomin_NS_BP_QM_TF_PnonTF_PH1_rhoH1.txt");
//ofstream fTS  ("timeseries_Rays1.txt"); //D:/freefem/NS_variable density/SUPG_Lag/nuDelta_E/
fupK.precision(16);
ofstream fTS  ("timeseries_Rays1.txt"); 
fTS.precision(16);

fTS  << "k\t t\t 1Mass\t 2MassResidual\t 3Mnm1\t 4rhoMin\t 5rhoMax\t 6Ehat\t 7Eref\t 8Eg\t 9Diss\t  10DE\t 11M/alpha\t 12TEg\t 13Mnms\t 14Ehatu\n";

ofstream fN  ("NewtonData.txt"); 
fN.precision(16);
fN  << "t\t xiIters\t F\t xi\n";


//real nuVal = muExact(0,0,0);
fupK << "% params: alpha=" << alpha
     << ", T0="    << T0
     << ", Tend="  << Tend
     //<< ", nu="    << nuVal
     //<< ", gammaGD=" << gammaGD
     << " , tol = " << tol  
	<< "2025/2/5" << "use old scheme No nudc" <<endl;
    fupK.flush;
cout << "[params] alpha=" << alpha
     << "  T0="   << T0
     << "  Tend=" << Tend
     << endl;
     //<< "  gammaGD=" << gammaGD 

// table header (add K Linf and L2)
fupK << "NX\t&\tNT\t&\th\t&\tdt"
     << "\t&\teuL2\t&\truL2"
     << "\t&\teuH1\t&\truH1"
     << "\t&\tedivL2\t&\trdivL2"
     << "\t&\tedivHm1\t&\trdivHm1"
     << "\t&\tepL2\t&\trpL2"
//     << "\t&\tepH1\t&\trpH1"
     << "\t&\terhoL2\t&\trrhoL2"
//     << "\t&\terhoH1\t&\trrhoH1"
     << "\t&\teMinf\t&\trMinf"
     /*<< "\t&\teM2\t&\trM2"*/ << "\t\\ \\hline" << endl;
