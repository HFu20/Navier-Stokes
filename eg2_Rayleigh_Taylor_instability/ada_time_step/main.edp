// adaptive time step
real t,tau,dt;
real dtmax = 1.0e-2;
real dtmin = 5.0e-4;
// dtvar-only adaptive controller parameters.
// Retuned from the hK-corrected RT energy trace to reduce the step around
// the nonlinear roll-up while keeping the controller target above dtmin.
real kappaAda = 1.1e5;


/* Kappa Parameters */
real Cflat = 0.1;
real Cmax = 1.06;
real betaU = 1.0;

string fTSName = "timeseries_Rays1.txt";
string fNName = "NewtonData.txt";
